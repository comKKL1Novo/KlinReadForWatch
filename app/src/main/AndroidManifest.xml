<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No storage permissions are declared on purpose.
      Books are opened through the Storage Access Framework, which grants
      per-file access the user explicitly approves. See BookImporter.kt.
    -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KlinRead"
        android:largeHeap="true"
        android:hardwareAccelerated="true">

        <!--
          largeHeap: a 220万字 book and its parsed paragraphs need more than the
          default heap on a low-memory watch. Without it the process can be
          killed during import on a device with roughly 256 MB available.

          hardwareAccelerated: stated explicitly because a watch AOSP image can
          leave it off, and Compose requires a hardware canvas.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.KlinRead"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density">
            <!--
              The config changes are handled here so that switching between round
              and square screens (or a density override) does not recreate the
              activity and lose the reading position.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
