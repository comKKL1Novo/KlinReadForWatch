# Normalise line endings in the repository, so a Windows checkout and a
# Linux/macOS checkout produce identical diffs.
* text=auto eol=lf

# Gradle wrapper scripts must stay executable on Unix.
gradlew text eol=lf
*.bat text eol=crlf

# Windows batch files stay CRLF; PowerShell accepts either, so keep it uniform.
*.cmd text eol=crlf
*.ps1 text eol=lf

# Binary assets: never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.jar binary
*.apk binary
*.aab binary
*.jks binary
*.keystore binary
